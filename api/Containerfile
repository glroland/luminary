FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/

# Where Florence-2, the local embedding model (embeddings.py -- both via
# transformers/huggingface_hub/sentence-transformers), and facenet-pytorch's
# vggface2 face-embedding weights (recognition.py's "Refresh Faces") cache
# their downloaded files -- set *before* the pre-download step below so
# it writes here, and left set for the running container so it reads from
# the exact same place at startup/first use instead of re-downloading.
ENV HF_HOME=/opt/model-cache/huggingface \
    TORCH_HOME=/opt/model-cache/torch

# Must match config.py's get_florence_model() default so the image's own
# built-in LUMINARY_FLORENCE_MODEL (set from this same ARG below) is what
# actually got cached -- override both together with
# `--build-arg LUMINARY_FLORENCE_MODEL=...` if you deploy a different
# checkpoint, or the runtime default and this cache will disagree and
# chat.py's _load_florence() will try to fetch the mismatched one instead.
ARG LUMINARY_FLORENCE_MODEL=microsoft/Florence-2-base

# Same reasoning, for embeddings.py's local embedding model -- must match
# config.py's get_embedding_model() default; override both together with
# `--build-arg LUMINARY_EMBEDDING_MODEL=...` or embeddings._load_embedder()
# will try to fetch the mismatched one instead of using this cache.
ARG LUMINARY_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Same, for rerank.py's cross-encoder (config.get_reranker_model()); an empty
# value disables reranking and skips the download.
ARG LUMINARY_RERANKER_MODEL=BAAI/bge-reranker-base

# download_models.py (also what `make install-models` runs locally) mirrors
# chat.py's _load_florence()/embeddings.py's _load_embedder()/
# recognition.py's _load_embedder() -- this needs network access
# at build time (same as the pip install above), so it has to run before
# HF_HUB_OFFLINE is set below.
COPY download_models.py ./
RUN mkdir -p "$HF_HOME" "$TORCH_HOME" && python download_models.py

# From here on, Florence-2/the embedding model must use the cache just
# populated above rather than silently re-downloading on the first real
# chat/sync/search request -- HF_HUB_OFFLINE makes transformers' and
# sentence-transformers' from_pretrained (both huggingface_hub-based)
# raise instead of even checking the network, so a cache/runtime-model
# mismatch fails loudly rather than downloading unexpectedly in a
# deployed container. facenet-pytorch's own downloader (facenet_pytorch/
# models/utils/download.py) already skips its request whenever the
# destination file exists under $TORCH_HOME, with no separate offline
# flag needed -- the pre-download step above is what makes that true.
ENV HF_HUB_OFFLINE=1 \
    LUMINARY_FLORENCE_MODEL=${LUMINARY_FLORENCE_MODEL} \
    LUMINARY_EMBEDDING_MODEL=${LUMINARY_EMBEDDING_MODEL} \
    LUMINARY_RERANKER_MODEL=${LUMINARY_RERANKER_MODEL}

# The Jenkins build number, passed by deploy/Jenkinsfile as
# `--build-arg LUMINARY_VERSION=$BUILD_NUMBER`. Left empty for a plain local
# `docker build`, which the About dialog then reports as development mode.
ARG LUMINARY_VERSION=
ENV LUMINARY_VERSION=${LUMINARY_VERSION}

ENV PYTHONPATH=/app/src \
    LUMINARY_DATA_DIR=/data/photos \
    LUMINARY_DATABASE_PATH=/data/photos.db \
    PORT=8080

RUN useradd --create-home --uid 1001 appuser \
    && mkdir -p /data/photos \
    && chown -R appuser:0 /data /app /opt/model-cache \
    && chmod -R a+rX,g+w /app /opt/model-cache \
    && chmod -R g=u /data

# OpenShift runs the container under an arbitrary UID (group 0), not appuser.
# facenet-pytorch downloads its weights via a tempfile, which leaves the
# .pt file mode 0600 -- unreadable to any other UID (PermissionError in
# recognition._load_embedder). The chmod above makes the baked-in caches
# world-readable regardless of how each library created its files.

USER appuser

EXPOSE 8080

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
